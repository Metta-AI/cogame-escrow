version     = "0.1.0"
author      = "daveey"
description = "Escrow: binding contracts as a coworld. Four cogs, three goods, comparative advantage, and a contract language the game itself executes; a policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
